{
  "name": "finflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:server-imports": "node scripts/check-server-imports.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-finflow \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --only firestore --project demo-finflow \"vitest run --config vitest.integration.config.ts\"",
    "migrate:ledger": "node --conditions=react-server --import tsx scripts/migrate-ledger-v2.ts",
    "test:e2e": "playwright test",
    "ui:shots": "firebase emulators:exec --only auth,firestore --project demo-finflow \"playwright test --config playwright.shots.config.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@stripe/stripe-js": "^9.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
